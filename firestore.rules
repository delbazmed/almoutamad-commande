// نسخة للمرجع فقط (لا تُنشر تلقائياً). تُلصق يدوياً في Firebase Console ← Firestore ← Rules
// استبدل PUT_YOUR_EMAIL_HERE ببريدك الذي أنشأت به المستخدم في Authentication.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'PUT_YOUR_EMAIL_HERE';
    }
    match /orders/{id} {
      // الزبون (بدون تسجيل دخول): إنشاء طلب جديد فقط، بحقول محددة وقيم صالحة
      allow create: if request.resource.data.keys().hasOnly(
            ['id','produitId','produit','ref','qualite','quantite','total','nom','telephone','wilaya','commune','vehicule','motorisation','source','status'])
        && request.resource.data.keys().hasAll(['id','produit','quantite','nom','telephone','wilaya','commune','status'])
        && id.matches('AM-[A-Z0-9]{5,8}')
        && request.resource.data.id == id
        && request.resource.data.status == 'Nouveau'
        && request.resource.data.quantite is int
        && request.resource.data.quantite >= 1 && request.resource.data.quantite <= 100
        && request.resource.data.total is int
        && request.resource.data.telephone.matches('^0[567][0-9]{8}$')
        && request.resource.data.nom is string && request.resource.data.nom.size() >= 3 && request.resource.data.nom.size() <= 100
        && request.resource.data.produit is string && request.resource.data.produit.size() <= 200;
      // المدير فقط: قراءة وتغيير الحالة/الملاحظة وحذف
      allow read, delete: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','note']);
    }
  }
}
